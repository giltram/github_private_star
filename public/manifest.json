{
  "manifest_version": 3,
  "name": "GitHub Private Star",
  "version": "0.2.8",
  "minimum_chrome_version": "120",
  "description": "Save private repository stars to a private GitHub repository you control.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
